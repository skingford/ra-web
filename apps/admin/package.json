{
  "name": "@ra-web/admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -b && vite build",
    "build:analyze": "ANALYZE=true npm run build",
    "build:profile": "tsc -b && vite build --mode profile",
    "lint": "eslint .",
    "preview": "vite preview --port 5174",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:performance": "vitest run --reporter=verbose src/**/*.perf.test.ts",
    "test:performance:watch": "vitest --reporter=verbose src/**/*.perf.test.ts",
    "bundle-size": "npm run build && npx bundlesize",
    "bundle-analyze": "npm run build:analyze && open dist/stats.html",
    "performance:benchmark": "npm run test:performance && npm run bundle-analyze",
    "performance:ci": "npm run test:performance -- --run"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.27.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ra-web/ui": "workspace:*",
    "@tanstack/react-query": "^5.89.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.16",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.2.1",
    "xlsx": "^0.18.5",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@pkg/vite-config": "workspace:*",
    "@tanstack/react-query-devtools": "^5.89.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jspdf": "^2.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@types/recharts": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^27.0.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.1.6",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}